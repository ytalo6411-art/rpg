# VEYRATH — variáveis de ambiente
# Copie este arquivo para .env e preencha antes de rodar em produção.
# NÃO commite o .env no GitHub (já ignorado pelo .gitignore).

# Ambiente Node
NODE_ENV=production

# Modo de operação: "local" (SQLite, desenvolvimento) ou "producao" (PostgreSQL)
VEYRATH_MODE=producao

# Servidor
PORT=4000
HOST=0.0.0.0
WS_PATH=/ws

# Origem do frontend (para CORS). Exemplo: https://veyrath.vercel.app
CLIENT_ORIGIN=https://veyrath.vercel.app

# Banco de dados (apenas usado quando VEYRATH_MODE=producao)
# Exemplo: postgres://veyrath:senha@localhost:5432/veyrath
DATABASE_URL=

# Segurança de contas (bcrypt)
BCRYPT_SALT_ROUNDS=10

# Limites de requisição (por IP, por minuto)
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# Economia do mundo (intervalo de simulação em ms)
WORLD_TICK_MS=10000

# Chave secreta para sessões/tokens (mude em produção — obrigatório)
SESSION_SECRET=troque-em-producao

# Variáveis expostas ao cliente (Vite) — preencha com as URLs de produção
# Exemplo: https://api.veyrath.app e wss://api.veyrath.app
VITE_API_URL=https://api.veyrath.app
VITE_WS_URL=wss://api.veyrath.app

# VEYRATH — variáveis de ambiente
# Copie este arquivo para .env e preencha antes de rodar em produção.

# Modo de operação: "local" (SQLite, desenvolvimento) ou "producao" (PostgreSQL)
VEYRATH_MODE=local

# Servidor
PORT=4000
HOST=0.0.0.0
WS_PATH=/ws
CLIENT_URL=http://localhost:5173

# Banco de dados (apenas usado quando VEYRATH_MODE=producao)
# Exemplo: postgres://veyrath:senha@localhost:5432/veyrath
DATABASE_URL=

# Segurança de contas (bcrypt)
BCRYPT_SALT_ROUNDS=10

# Limites de requisição (por IP, por minuto)
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# Economia do mundo (intervalo de simulação em ms)
WORLD_TICK_MS=10000

# Chave secreta para sessões/tokens (mude em produção)
SESSION_SECRET=troque-em-producao

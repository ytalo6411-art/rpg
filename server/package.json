{
  "name": "@veyrath/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "node --input-type=module -e \"import('./dist/migrate.js')\"",
    "seed": "node --input-type=module -e \"import('./dist/migrate.js')\"",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --runInBand 2>/dev/null || npx tsx test/run.ts"
  },
  "dependencies": {
    "@veyrath/shared": "file:../shared",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "pg": "^8.13.0",
    "uuid": "^10.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.10",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
